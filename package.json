{
  "name": "mmd-viz",
  "version": "0.9.0",
  "description": "Turn Mermaid diagrams into sleek, zero-JS styled & animated SVGs (GitHub & docs ready), powered by Pele.",
  "license": "MIT",
  "author": "phil65",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phil65/mmd-viz.git"
  },
  "homepage": "https://github.com/phil65/mmd-viz#readme",
  "bugs": {
    "url": "https://github.com/phil65/mmd-viz/issues"
  },
  "keywords": [
    "mermaid",
    "svg",
    "animation",
    "diagrams",
    "pele",
    "flowchart",
    "markdown",
    "readme",
    "cli"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mindmap": {
      "types": "./dist/mindmap.d.ts",
      "import": "./dist/mindmap.js"
    },
    "./animate": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./interactive": {
      "types": "./dist/interactive.d.ts",
      "import": "./dist/interactive.js"
    }
  },
  "bin": {
    "mmd-viz": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "pele": "^1.13.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.8.0",
    "unified": "^11.0.5",
    "vitest": "^3.1.0"
  }
}
